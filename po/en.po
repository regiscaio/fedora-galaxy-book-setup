msgstr "Audio"

#: src/ui/window/groups.rs:129
msgid ""
"Validação do caminho MAX98390 e do painel Galaxy Book Sound usado no ajuste "
"fino do áudio."
msgstr ""
"Validation of the MAX98390 path and the Galaxy Book Sound panel used to fine-"
"tune audio."

#: src/ui/window/groups.rs:137
msgid "Biometria"
msgstr "Biometrics"

#: src/ui/window/groups.rs:138
msgid ""
"Presença do leitor integrado, resposta do stack fprintd/libfprint e "
"prontidão do login por digital."
msgstr ""
"Presence of the built-in reader, fprintd/libfprint stack response and "
"fingerprint login readiness."

#: src/ui/window/groups.rs:146
msgid "GPU, Secure Boot e plataforma"
msgstr "GPU, Secure Boot and platform"

#: src/ui/window/groups.rs:147
msgid ""
"Estabilidade do driver NVIDIA, prontidão da chave MOK do akmods e perfil de "
"uso balanceado da plataforma."
msgstr ""
"NVIDIA driver stability, akmods MOK key readiness and the platform's "
"balanced usage profile."

#: src/ui/window/groups.rs:157
msgid "Integrações do desktop"
msgstr "Desktop integrations"

#: src/ui/window/groups.rs:158
msgid ""
"Checklist geral de extensões e integrações do desktop, incluindo a dock "
"usada neste notebook."
msgstr ""
"General checklist of desktop extensions and integrations, including the dock "
"used on this notebook."

#: src/ui/window/groups.rs:223 src/ui/window/pages.rs:41
#: src/ui/window/pages.rs:78 src/ui/window/pages.rs:82
msgid "Ações rápidas"
msgstr "Quick actions"

#: src/ui/window/groups.rs:225
msgid ""
"Fluxos executáveis diretamente da interface, sem precisar digitar comandos."
msgstr ""
"Flows that can be run directly from the interface, without typing commands."

#: src/ui/window/pages.rs:27
msgid "Áreas do assistente"
msgstr "Assistant areas"

#: src/ui/window/pages.rs:29
msgid "Acesse as áreas operacionais do auxiliar de instalação e diagnóstico."
msgstr ""
"Access the operational areas of the installation and diagnostics assistant."

